<?xml version="1.0" encoding="utf-8"?>
<com.statusvault.app.AspectFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tile"
    android:descendantFocusability="blocksDescendants">

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/play"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_play_badge"
        android:contentDescription="Video"
        android:padding="7dp"
        android:src="@drawable/ic_play"
        android:visibility="gone" />

    <TextView
        android:id="@+id/badge_new"
        style="@style/Pill"
        android:layout_gravity="top|start"
        android:layout_margin="6dp"
        android:text="NEW" />

    <TextView
        android:id="@+id/badge_time"
        style="@style/Pill"
        android:layout_gravity="bottom|start"
        android:layout_margin="8dp"
        android:background="@drawable/bg_time_pill"
        android:drawableStart="@drawable/ic_timer_small"
        android:drawablePadding="3dp"
        android:paddingStart="5dp"
        android:textColor="#FFFFFF" />

    <ImageButton
        android:id="@+id/save"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_save_button"
        android:contentDescription="Save"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_download"
        android:tint="@color/on_primary_container" />

    <View
        android:id="@+id/sel_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/sel_check"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:contentDescription="@null"
        android:visibility="gone" />
</com.statusvault.app.AspectFrameLayout>
