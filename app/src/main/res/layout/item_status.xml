<?xml version="1.0" encoding="utf-8"?>
<!-- Outer frame draws the story-style ring (unseen statuses); the inner card holds the media. -->
<com.statusvault.app.AspectFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ring"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:padding="3dp">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_tile_scrim" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_glass_pill"
            android:drawableStart="@drawable/ic_play_small"
            android:drawablePadding="2dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="9dp"
            android:paddingEnd="7dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/time_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#80000000"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/save"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Save"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_download" />
            </LinearLayout>

            <!-- Time left until WhatsApp deletes it -->
            <FrameLayout
                android:id="@+id/expiry_track"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/bg_expiry_track">

                <View
                    android:id="@+id/expiry_fill"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>

        <View
            android:id="@+id/sel_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/sel_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>
</com.statusvault.app.AspectFrameLayout>
