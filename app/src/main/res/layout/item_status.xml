<?xml version="1.0" encoding="utf-8"?>
<!-- Outer frame draws the rotating story ring (unseen) or a hairline (seen); the inner card holds the media. -->
<com.hamster.statussaver.AspectFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ring"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="blocksDescendants"
    android:padding="4dp">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_tile_scrim" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_glass_pill"
            android:drawableStart="@drawable/ic_play_small"
            android:drawablePadding="2dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Bottom row: circular countdown (statuses) and the save button -->
        <LinearLayout
            android:id="@+id/bottom_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingBottom="7dp">

            <com.hamster.statussaver.CountdownBadge
                android:id="@+id/countdown"
                android:layout_width="30dp"
                android:layout_height="30dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/save"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Save"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_download" />
        </LinearLayout>

        <View
            android:id="@+id/sel_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/sel_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:contentDescription="@null"
            android:visibility="gone" />
    </FrameLayout>
</com.hamster.statussaver.AspectFrameLayout>
