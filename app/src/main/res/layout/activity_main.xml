<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Header, swapped for a selection bar while selecting -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/refresh"
                style="@style/BarButton"
                android:contentDescription="Refresh"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/settings"
                style="@style/BarButton"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/selection_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/sel_close"
                style="@style/BarButton"
                android:contentDescription="Cancel selection"
                android:src="@drawable/ic_close" />

            <TextView
                android:id="@+id/sel_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton android:id="@+id/sel_all" style="@style/BarButton" android:contentDescription="Select all" android:src="@drawable/ic_select_all" />
            <ImageButton android:id="@+id/sel_save" style="@style/BarButton" android:contentDescription="Save selected" android:src="@drawable/ic_download" />
            <ImageButton android:id="@+id/sel_repost" style="@style/BarButton" android:contentDescription="Repost to WhatsApp" android:src="@drawable/ic_repost" />
            <ImageButton android:id="@+id/sel_share" style="@style/BarButton" android:contentDescription="Share selected" android:src="@drawable/ic_share" />
            <ImageButton android:id="@+id/sel_delete" style="@style/BarButton" android:contentDescription="Delete selected" android:src="@drawable/ic_delete" />
        </LinearLayout>
    </FrameLayout>

    <!-- Section switcher -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/tab_whatsapp"
            style="@style/SegmentTab"
            android:text="WhatsApp" />

        <TextView
            android:id="@+id/tab_business"
            style="@style/SegmentTab"
            android:text="Business" />

        <TextView
            android:id="@+id/tab_saved"
            style="@style/SegmentTab"
            android:text="Saved" />
    </LinearLayout>

    <!-- Photo / video filter -->
    <LinearLayout
        android:id="@+id/filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <TextView android:id="@+id/chip_all" style="@style/Chip" />
        <TextView android:id="@+id/chip_photos" style="@style/Chip" />
        <TextView android:id="@+id/chip_videos" style="@style/Chip" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:textColor="@color/on_surface_variant"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:horizontalSpacing="8dp"
            android:numColumns="3"
            android:padding="16dp"
            android:scrollbarStyle="outsideOverlay"
            android:stretchMode="columnWidth"
            android:verticalSpacing="8dp" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/empty_icon"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@null"
                android:tint="@color/primary" />

            <TextView
                android:id="@+id/empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/empty_body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/on_surface_variant"
                android:textSize="15sp" />

            <Button
                android:id="@+id/empty_action"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
